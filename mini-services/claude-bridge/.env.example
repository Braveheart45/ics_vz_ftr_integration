# ============================================================
# claude-bridge — environment configuration
# ============================================================
# Copy to .env, edit values, and restart the bridge.
# Every value below is OPTIONAL — defaults apply when unset.
# Malformed values fail the bridge at startup with an aggregated
# error report (see config.js for the validation policy).
# ============================================================

# ── HTTP server ───────────────────────────────────────────────
BRIDGE_PORT=3001

# ── Claude CLI orchestration ─────────────────────────────────
# Maximum tool-use turns per Claude session (range 1..200).
# The linear S01→S14 flow performs ~10–18 tool calls plus reasoning, so 25
# was too tight and forced an auto-retry on the second pass. 50 leaves headroom.
CLAUDE_MAX_TURNS=50
# Hard wall-clock limit for a Claude session in ms (range 1000..3_600_000).
CLAUDE_TIMEOUT_MS=1200000
# Maximum concurrent in-flight bridge requests (range 1..32).
CLAUDE_MAX_CONCURRENT=3

# ── Server limits ────────────────────────────────────────────
# How many of the most-recent client chat messages to forward to Claude.
MAX_HISTORY_MESSAGES=20
# Max accepted request body size (bytes). Default 2 MB.
SQL_CURATOR_MAX_REQUEST_BODY_BYTES=2097152
# Max in-memory stream buffer per Claude session before the bridge aborts.
# Protects against runaway responses; default 8 MB.
SQL_CURATOR_MAX_STREAM_BUFFER_BYTES=8388608

# ── Offline mode (development only) ──────────────────────────
# When true, the bridge serves a deterministic stub instead of calling
# Claude. Useful for UI testing without Claude credentials. Default false.
SQL_CURATOR_ENABLE_OFFLINE_DRY_RUN=false

# ── Logging ──────────────────────────────────────────────────
# Log verbosity: trace | debug | info | warn | error | fatal. Default info.
SQL_CURATOR_LOG_LEVEL=info
