// ============================================================
// SQLForge — Database Schema
// SQLite via Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── SQL Generation Sessions ─────────────────────────────────

model Session {
  id          String   @id @default(cuid())
  sessionId   String   @unique              // Client-generated UUID
  taskType    String   @default("auto_detect")
  jiraRef     String?                       // e.g. "VF-1234"
  bqProject   String?
  status      String   @default("active")   // active | completed | archived
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  generations Generation[]
}

// ── SQL Generation Results ──────────────────────────────────

model Generation {
  id          String   @id @default(cuid())
  sessionId   String
  session     Session  @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade)
  version     Int      @default(1)
  sql         String                        // Generated SQL content
  fileName    String
  llmResponse String?                       // Full LLM response text
  isValid     Boolean?                       // Dry-run result
  errorMessage String?
  createdAt   DateTime @default(now())

  stmArtifacts StmArtifact[]
}

// ── STM (Source-to-Target Mapping) Artifacts ───────────────

model StmArtifact {
  id          String   @id @default(cuid())
  generationId String
  generation  Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  title       String
  description String   @default("")
  source      String                       // jira | file | text | legacy_sql
  jiraRef     String?
  bqProject   String
  version     Int      @default(1)
  rowCount    Int
  rowsJson    String                        // JSON string of STM rows array
  createdAt   DateTime @default(now())
}
