# SQL Curator — Environment Variables
# Copy this file to .env and fill in your values.

# SQLite database path (used internally — not required for core SQL generation)
DATABASE_URL=file:./db/custom.db

# Set to true to route SQL generation through the local Claude bridge (required)
USE_CLAUDE_BRIDGE=true

# Port for the claude-bridge mini-service (default: 3001)
BRIDGE_PORT=3001
